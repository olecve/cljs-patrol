{:paths ["src" "resources"]
 :deps
 {rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}
  hiccup/hiccup {:mvn/version "2.0.0-RC3"}
  org.clojure/tools.cli {:mvn/version "1.1.230"}
  com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}}

 :aliases
 {:run
  {:main-opts ["-m" "cljs-patrol.core"]}

  :build
  {:extra-deps {io.github.clojure/tools.build {:git/tag "v0.9.6" :git/sha "8e78bcc"}}
   :ns-default build}

  :cljfmt
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.4"}}
   :main-opts ["-m" "cljfmt.main"]}

  ;; The one clj-kondo version. Compose it with the alias that runs clj-kondo:
  ;; clojure -M:clj-kondo-deps:clj-kondo, clojure -M:clj-kondo-deps:java-io-check and clojure -M:clj-kondo-deps:test
  :clj-kondo-deps
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}}

  :clj-kondo
  {:main-opts ["-m" "clj-kondo.main"]}

  :java-io-check
  {:extra-paths ["dev"]
   :main-opts ["-m" "cljs-patrol.dev.java-io-check"]}

  ;; The mutation runner, from its own repository: clojure -M:test:mutate TARGET-NS -t TEST-NS
  :mutate
  {:extra-deps {io.github.olecve/mutacio-clj {:git/tag "v0.1.0" :git/sha "becc654"}}
   :main-opts ["-m" "mutacio.main"]}

  :test
  {:extra-paths ["test" "dev"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                com.google.jimfs/jimfs {:mvn/version "1.3.2"}
                metosin/malli {:mvn/version "0.20.3"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}}}
