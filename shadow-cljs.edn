{:source-paths ["src" "test"]
 :dependencies [[rewrite-clj/rewrite-clj "1.1.47"]]
 :builds {:node {:target :node-script
                 :main cljs-patrol.node/-main
                 :output-to "cljs-patrol.js"}
          :tests {:target :node-test
                  :output-to "out/tests.js"
                  :ns-regexp "-test$"
                  :autorun true
                  :compiler-options {:warnings {:redef false}}}}}
