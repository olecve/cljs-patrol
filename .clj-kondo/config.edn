;; Linters clj-kondo ships off or at :info.
{;; Code that must keep java.io: the mutation runner and its tests need git and the real disk, the other tests make
 ;; fixture files on the real disk, and tools.build takes strings.
 :ns-groups [{:filename-pattern "(^|/)(dev|test)/" :name java-io-allowed}]

 :config-in-ns
 {java-io-allowed {:linters {:discouraged-var {clojure.core/slurp {:level :off}
                                               clojure.core/spit {:level :off}
                                               clojure.java.io/file {:level :off}
                                               clojure.java.io/reader {:level :off}
                                               clojure.java.io/writer {:level :off}}}}
  build {:linters {:discouraged-var {clojure.core/slurp {:level :off}
                                     clojure.core/spit {:level :off}
                                     clojure.java.io/file {:level :off}
                                     clojure.java.io/reader {:level :off}
                                     clojure.java.io/writer {:level :off}}}}
  ;; These read a classpath resource, which has no `Path` on the default file system.
  cljs-patrol.group {:linters {:discouraged-var {clojure.core/slurp {:level :off}}}}
  cljs-patrol.groups.css-order.orders {:linters {:discouraged-var {clojure.core/slurp {:level :off}}}}
  cljs-patrol.reporters.html {:linters {:discouraged-var {clojure.core/slurp {:level :off}}}}}

 :linters
 {;; Real defects
  :case-symbol-test {:level :error}
  :equals-float {:level :error}
  :main-without-gen-class {:level :error}

  ;; Dead or misleading code
  :unused-alias {:level :warning}
  :unused-binding {:level :warning}
  :unused-namespace {:level :warning}
  :used-underscored-binding {:level :warning}
  :redundant-let-binding {:level :warning}
  :redundant-call {:level :warning}
  :redundant-fn-wrapper {:level :warning}
  :redundant-format {:level :warning}
  :redundant-ignore {:level :warning}
  :redundant-nested-call {:level :warning}
  :redundant-primitive-coercion {:level :warning}
  :redundant-str-call {:level :warning}
  :unresolved-excluded-var {:level :warning}
  :unused-excluded-var {:level :warning}

  ;; Idiom
  :aliased-namespace-symbol {:level :warning}
  :aliased-referred-var {:level :warning}
  :conditional-build-up {:level :warning}
  :equals-false {:level :warning}
  :equals-nil {:level :warning}
  :equals-true {:level :warning}
  :if-nil-return {:level :warning}
  :if-x-x-y {:level :warning}
  :minus-one {:level :warning}
  :not-nil? {:level :warning}
  :plus-one {:level :warning}
  :seq-rest {:level :warning}
  :single-key-in {:level :warning}

  ;; Ordering
  :unsorted-imports {:level :warning}
  :unsorted-required-namespaces {:level :warning}

  :is-message-not-string {:level :warning}

  ;; :missing-docstring stays off: CLAUDE.md prefers none to a redundant one.
  :docstring-blank {:level :warning}
  :docstring-leading-trailing-whitespace {:level :warning}
  :docstring-no-summary {:level :warning}

  ;; ADR 0013: files are read and written through `java.nio.file.Path`.
  :discouraged-var
  {clojure.core/slurp {:message "Use fs/read-text with a Path. Only a classpath resource is read with slurp."}
   clojure.core/spit {:message "Use fs/text-writer with a Path."}
   clojure.java.io/file {:message "Use fs/path. java.io.File reads a nil parent as the working directory."}
   clojure.java.io/reader {:message "Use fs/read-text with a Path."}
   clojure.java.io/writer {:message "Use fs/text-writer with a Path."}}

  ;; The string adapters of cljs-patrol.fs are deprecated. Only fs-test still calls them, to test them until step 4 of
  ;; ADR 0013 removes them.
  :deprecated-var
  {:exclude
   {cljs-patrol.fs/absolute-path {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/absolute-path? {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/delete-file! {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/delete-tree! {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/file-exists? {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/join-path {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/list-source-files {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/missing-dirs {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/mkdirs {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/move-replace! {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/parent-dir {:namespaces [cljs-patrol.fs-test]}
    cljs-patrol.fs/relativize {:namespaces [cljs-patrol.fs-test]}}}}}
