;; Linters clj-kondo ships off or at :info.
{:linters
 {;; Real defects
  :case-symbol-test {:level :error}
  :equals-float {:level :error}
  :main-without-gen-class {:level :error}

  ;; Dead or misleading code
  :unused-alias {:level :warning}
  :unused-binding {:level :warning}
  :unused-namespace {:level :warning}
  :used-underscored-binding {:level :warning}
  :redundant-let-binding {:level :warning}
  :redundant-call {:level :warning}
  :redundant-fn-wrapper {:level :warning}
  :redundant-format {:level :warning}
  :redundant-ignore {:level :warning}
  :redundant-nested-call {:level :warning}
  :redundant-primitive-coercion {:level :warning}
  :redundant-str-call {:level :warning}
  :unresolved-excluded-var {:level :warning}
  :unused-excluded-var {:level :warning}

  ;; Idiom
  :aliased-namespace-symbol {:level :warning}
  :aliased-referred-var {:level :warning}
  :conditional-build-up {:level :warning}
  :equals-false {:level :warning}
  :equals-nil {:level :warning}
  :equals-true {:level :warning}
  :if-nil-return {:level :warning}
  :if-x-x-y {:level :warning}
  :minus-one {:level :warning}
  :not-nil? {:level :warning}
  :plus-one {:level :warning}
  :seq-rest {:level :warning}
  :single-key-in {:level :warning}

  ;; Ordering
  :unsorted-imports {:level :warning}
  :unsorted-required-namespaces {:level :warning}

  :is-message-not-string {:level :warning}

  ;; :missing-docstring stays off: CLAUDE.md prefers none to a redundant one.
  :docstring-blank {:level :warning}
  :docstring-leading-trailing-whitespace {:level :warning}
  :docstring-no-summary {:level :warning}}}
